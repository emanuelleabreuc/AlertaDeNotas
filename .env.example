# Copie este arquivo para ".env" e preencha com os seus dados.
# O .env nunca vai para o GitHub (está no .gitignore).
MATRICULA=coloque_sua_matricula
SENHA=coloque_sua_senha

# Telegram (opcional). Sem isso, as novidades só aparecem no terminal.
# Veja no README.md como criar o bot e descobrir o chat_id.
TELEGRAM_TOKEN=coloque_o_token_do_bot
TELEGRAM_CHAT_ID=coloque_seu_chat_id
